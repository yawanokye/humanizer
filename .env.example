# Render supplies PORT automatically. Do not hardcode it in production.
PORT=10000
WEB_CONCURRENCY=1

# Engine 1 is the default local rewrite engine and needs no API key.
# Leave provider as none unless you want Engine 2 API rewrite.
HUMANIZER_PROVIDER=none

# Engine 2 OpenAI-compatible provider example for Render.
# Add HUMANIZER_API_KEY as a secret in the Render Dashboard, never in Git.
# HUMANIZER_PROVIDER=openai_compatible
# HUMANIZER_MODEL=your-model-name
# HUMANIZER_BASE_URL=https://your-provider.example/v1
# HUMANIZER_API_KEY=your-secret-key

# Ollama normally needs a separate reachable service. localhost refers to this
# web-service container and will not reach Ollama running on your own computer.
# HUMANIZER_PROVIDER=ollama
# HUMANIZER_MODEL=llama3.1:8b
# HUMANIZER_BASE_URL=http://your-private-ollama-service:11434

HUMANIZER_TIMEOUT_SECONDS=180
HUMANIZER_MAX_INPUT_CHARS=1200000
HUMANIZER_MAX_UPLOAD_BYTES=15728640
PROJECTREADY_HUMANIZER_PERPLEXITY_LEVEL=high
PROJECTREADY_HUMANIZER_BURSTINESS_LEVEL=high
PROJECTREADY_HUMANIZER_MAX_WORD_CHANGE_RATIO=0.06
