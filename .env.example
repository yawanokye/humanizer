# Render supplies PORT automatically. Do not hardcode it in production.
PORT=10000
WEB_CONCURRENCY=1

# ============================================================
# REWRITE ENGINES
# ============================================================
# Engine 1, Local rewrite, is the default and needs no API key.
# Use "none" if you want only Engine 1.
HUMANIZER_PROVIDER=none

# ============================================================
# ENGINE 2, OPENAI API REWRITE
# ============================================================
# To enable Engine 2 with OpenAI, set HUMANIZER_PROVIDER=openai
# and add the following three variables in Render.
# Keep OPENAI_API_KEY secret and never commit a real key to Git.
#
# HUMANIZER_PROVIDER=openai
# OPENAI_API_KEY=sk-your-secret-key
# OPENAI_MODEL=gpt-5.6-terra
# Economy/high-volume alternative: OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# ENGINE 2, OTHER OPENAI-COMPATIBLE API
# ============================================================
# Generic variables are retained for third-party compatible APIs.
#
# HUMANIZER_PROVIDER=openai_compatible
# HUMANIZER_MODEL=your-model-name
# HUMANIZER_BASE_URL=https://your-provider.example/v1
# HUMANIZER_API_KEY=your-secret-key

# ============================================================
# ENGINE 2, OLLAMA
# ============================================================
# Ollama normally needs a separately reachable service in production.
# localhost refers to this web-service container, not your own computer.
#
# HUMANIZER_PROVIDER=ollama
# HUMANIZER_MODEL=llama3.1:8b
# HUMANIZER_BASE_URL=http://your-private-ollama-service:11434

HUMANIZER_TIMEOUT_SECONDS=180
HUMANIZER_MAX_INPUT_CHARS=1200000
HUMANIZER_MAX_UPLOAD_BYTES=15728640
PROJECTREADY_HUMANIZER_PERPLEXITY_LEVEL=high
PROJECTREADY_HUMANIZER_BURSTINESS_LEVEL=high
PROJECTREADY_HUMANIZER_MAX_WORD_CHANGE_RATIO=0.06
