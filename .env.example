# Render supplies PORT automatically. Do not hardcode it in production.
PORT=10000
WEB_CONCURRENCY=1

# ============================================================
# REWRITE ENGINES
# ============================================================
# Engine 1 and Engine 3 are local and need no API call. Engine 2 is preconfigured
# for OpenAI when a key is present. Set HUMANIZER_PROVIDER=none if you
# intentionally want to disable Engine 2.

# ============================================================
# ENGINE 2, OPENAI API REWRITE
# ============================================================
# Add your secret API key in Render or your local .env file.
HUMANIZER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Economy/high-volume alternative: gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# ENGINE 2, OTHER OPENAI-COMPATIBLE API
# ============================================================
# Generic variables are retained for third-party compatible APIs.
#
# HUMANIZER_PROVIDER=openai_compatible
# HUMANIZER_MODEL=your-model-name
# HUMANIZER_BASE_URL=https://your-provider.example/v1
# HUMANIZER_API_KEY=your-secret-key

# ============================================================
# ENGINE 2, OLLAMA
# ============================================================
# Ollama normally needs a separately reachable service in production.
# localhost refers to this web-service container, not your own computer.
#
# HUMANIZER_PROVIDER=ollama
# HUMANIZER_MODEL=llama3.1:8b
# HUMANIZER_BASE_URL=http://your-private-ollama-service:11434

HUMANIZER_TIMEOUT_SECONDS=180
HUMANIZER_MAX_INPUT_CHARS=1200000
HUMANIZER_MAX_UPLOAD_BYTES=15728640
PROJECTREADY_HUMANIZER_PERPLEXITY_LEVEL=high
PROJECTREADY_HUMANIZER_BURSTINESS_LEVEL=high
PROJECTREADY_HUMANIZER_MAX_WORD_CHANGE_RATIO=0.18

# ============================================================
# v2.4 DETECTOR CALIBRATION
# ============================================================
# Optional path to a trained calibration/meta-classifier JSON artifact.
# If absent, the dashboard explicitly uses the transparent four-layer fallback.
# HUMANIZER_CALIBRATION_MODEL=calibration/meta_classifier.json

# ============================================================
# v2.4 OPTIONAL TRUE REFERENCE-LM PERPLEXITY + CURVATURE PROXY
# ============================================================
# Leave disabled on small/free Render instances. If enabled, install
# requirements-reference-lm.txt and provide/cache the model.
REFERENCE_LM_ENABLED=false
REFERENCE_LM_MODEL=distilgpt2
REFERENCE_LM_LOCAL_ONLY=true
REFERENCE_LM_MAX_TOKENS=2048
REFERENCE_LM_LOW_SURPRISAL_THRESHOLD=1.5

# ============================================================
# v2.4 PRIVATE BENCHMARK LAB + VALIDATION CENTRE
# ============================================================
# Disabled by default. Turn on only for a private/developer deployment.
HUMANIZER_BENCHMARK_LAB_ENABLED=false
# Required whenever the lab is enabled. This is the private developer password.
HUMANIZER_DEVELOPER_TOKEN=
# On Render, point this to a persistent disk if you want samples to survive deploys.
# HUMANIZER_BENCHMARK_DIR=/var/data/humanizer-calibration

# Maximum human false-positive rate used when choosing the trained decision threshold.
HUMANIZER_MAX_HUMAN_FPR=0.05
